@import url('https://fonts.googleapis.com/css2?family=Bree+Serif&family=Caveat:wght@400;700&family=Lobster&family=Monoton&family=Open+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Playfair+Display+SC:ital,wght@0,400;0,700;1,700&family=Playfair+Display:ital,wght@0,400;0,700;1,700&family=Roboto:ital,wght@0,400;0,700;1,400;1,700&family=Source+Sans+Pro:ital,wght@0,400;0,700;1,700&family=Work+Sans:ital,wght@0,400;0,700;1,700&display=swap');
/* ================================================================
   GRAND PALACE HOTEL — STYLESHEET
   A premium, responsive luxury hotel website built with CSS3 only.
   Sections:
   1. Design tokens & reset
   2. Global typography, layout & buttons
   3. Top bar & header navigation
   4. Hero & quick-information strip
   5. About
   6. Rooms
   7. Interlude quote
   8. Facilities
   9. Booking form
   10. Guest reviews
   11. Contact
   12. Footer
   13. Responsive design
   ================================================================ */

/* ================= 1. DESIGN TOKENS & RESET ================= */
:root {
    --navy-950: #071521;
    --navy-900: #0b1f31;
    --navy-800: #122b41;
    --navy-700: #1b3a52;
    --gold: #c9a25b;
    --gold-light: #e3c68a;
    --gold-deep: #96703a;
    --ivory: #f7f3ea;
    --cream: #fbf8f1;
    --white: #ffffff;
    --ink: #34434f;
    --muted: #71808b;
    --line: #e9e2d4;
    --shadow-soft: 0 14px 40px rgba(11, 31, 49, 0.08);
    --shadow-large: 0 30px 65px rgba(11, 31, 49, 0.16);
    --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    --sans: "Jost", "Segoe UI", Arial, sans-serif;
    --container: 1180px;
}

*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 88px;
    -webkit-text-size-adjust: 100%;
}

body {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--ink);
    background-color: var(--cream);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

img {
    display: block;
    max-width: 100%;
    height: auto;
}

a {
    color: inherit;
    text-decoration: none;
}

ul,
ol {
    list-style: none;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

svg {
    display: block;
}

::selection {
    background: var(--gold);
    color: var(--navy-950);
}

:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
}

section {
    scroll-margin-top: 88px;
}

/* ================= 2. GLOBAL TYPOGRAPHY, LAYOUT & BUTTONS ================= */
h1,
h2,
h3,
h4 {
    font-family: var(--serif);
    font-weight: 500;
    line-height: 1.1;
    color: var(--navy-900);
}

h2 {
    font-size: clamp(2.1rem, 4vw, 3.3rem);
    letter-spacing: -0.01em;
}

p {
    font-weight: 300;
}

.container {
    width: min(var(--container), calc(100% - 48px));
    margin-inline: auto;
}

.section {
    padding: 106px 0;
}

.section--white {
    background-color: var(--white);
}

.section--cream {
    background-color: var(--cream);
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold-deep);
}

.eyebrow-rule {
    flex: 0 0 auto;
    width: 34px;
    height: 1px;
    background: var(--gold);
}

.eyebrow--light {
    color: var(--gold-light);
}

.eyebrow--center {
    justify-content: center;
}

.section-head {
    max-width: 680px;
    margin-bottom: 52px;
}

.section-head h2 {
    margin-bottom: 14px;
}

.section-lede {
    max-width: 590px;
    font-size: 0.98rem;
    line-height: 1.8;
    color: var(--muted);
}

.split-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    max-width: none;
}

.split-head>div:first-child {
    max-width: 670px;
}

.head-note {
    max-width: 330px;
    padding-left: 22px;
    border-left: 1px solid var(--gold);
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--muted);
}

.stars {
    color: var(--gold);
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    line-height: 1;
    white-space: nowrap;
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 50px;
    padding: 13px 27px;
    border: 1px solid transparent;
    border-radius: 4px;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.3;
    transition: background-color 0.35s ease, color 0.35s ease,
        border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
}

.btn svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s ease;
}

.btn:hover svg {
    transform: translateX(4px);
}

.btn-gold {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--navy-950);
}

.btn-gold:hover {
    background: var(--gold-light);
    border-color: var(--gold-light);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(201, 162, 91, 0.3);
}

.btn-ghost-light {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.45);
    color: var(--white);
}

.btn-ghost-light:hover {
    background: var(--white);
    border-color: var(--white);
    color: var(--navy-900);
    transform: translateY(-2px);
}

.btn-outline {
    background: transparent;
    border-color: #d8d1c3;
    color: var(--navy-900);
}

.btn-outline:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--navy-950);
    transform: translateY(-2px);
}

.btn-small {
    min-height: 42px;
    padding: 10px 18px;
    font-size: 0.66rem;
    letter-spacing: 0.13em;
}

/* Accessibility skip link */
.skip-link {
    position: absolute;
    top: -60px;
    left: 18px;
    z-index: 999;
    padding: 12px 20px;
    background: var(--gold);
    color: var(--navy-950);
    font-size: 0.8rem;
    font-weight: 500;
    transition: top 0.25s ease;
}

.skip-link:focus {
    top: 12px;
}

/* ================= 3. TOP BAR & HEADER ================= */
.topbar {
    background: var(--navy-950);
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    padding: 9px 0;
}

.topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
}

.topbar-item {
    display: flex;
    align-items: center;
    gap: 8px;
}

.topbar-item svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.topbar-item a {
    transition: color 0.3s ease;
}

.topbar-item a:hover {
    color: var(--gold-light);
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 15px 0;
    background: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid #ece6da;
    box-shadow: 0 4px 22px rgba(11, 31, 49, 0.05);
}

.header-inner {
    display: flex;
    align-items: center;
    gap: 30px;
}

/* Brand / logo */
.brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
}

.brand-mark {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--gold);
    background: #fcf9f2;
    color: var(--gold-deep);
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    position: relative;
    transition: background-color 0.35s ease, color 0.35s ease;
}

.brand-mark::after {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(201, 162, 91, 0.35);
    pointer-events: none;
}

.brand:hover .brand-mark {
    background: var(--navy-900);
    color: var(--gold-light);
}

.brand-text {
    display: flex;
    flex-direction: column;
}

.brand-title {
    font-family: var(--serif);
    font-size: 1.17rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.16em;
    color: var(--navy-900);
    text-transform: uppercase;
}

.brand-subtitle {
    margin-top: 3px;
    font-size: 0.48rem;
    font-weight: 400;
    letter-spacing: 0.31em;
    text-transform: uppercase;
    color: var(--gold-deep);
}

/* Primary navigation */
.primary-nav {
    margin-left: auto;
}

.primary-nav ul {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
}

.primary-nav a {
    position: relative;
    display: inline-block;
    padding: 6px 0;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2b4050;
    transition: color 0.3s ease;
}

.primary-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--gold);
    transition: width 0.35s ease;
}

.primary-nav a:hover,
.primary-nav a[aria-current="page"] {
    color: var(--gold-deep);
}

.primary-nav a:hover::after,
.primary-nav a[aria-current="page"]::after {
    width: 100%;
}

.header-cta {
    flex-shrink: 0;
    min-height: 44px;
    padding: 10px 21px;
    font-size: 0.67rem;
}

/* ================= 4. HERO & QUICK-INFORMATION STRIP ================= */
.hero {
    position: relative;
    display: block;
    min-height: 720px;
    padding: 0;
    overflow: hidden;
    color: var(--white);
    background: var(--navy-950);
}

.hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

.hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
        linear-gradient(90deg, rgba(4, 15, 25, 0.94) 0%, rgba(4, 15, 25, 0.82) 40%, rgba(4, 15, 25, 0.35) 78%, rgba(4, 15, 25, 0.48) 100%),
        linear-gradient(0deg, rgba(4, 15, 25, 0.9) 0%, rgba(4, 15, 25, 0) 45%);
}

.hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.32fr 0.68fr;
    align-items: center;
    gap: clamp(36px, 5vw, 68px);
    padding-top: 76px;
    padding-bottom: 72px;
}

.hero-content {
    max-width: 680px;
    animation: heroRise 0.9s ease both;
}

@keyframes heroRise {
    from {
        opacity: 0;
        transform: translateY(22px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hero h1 {
    margin-bottom: 22px;
    font-size: clamp(2.9rem, 5.7vw, 4.9rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--white);
}

.hero h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--gold-light);
}

.hero-text {
    max-width: 540px;
    margin-bottom: 31px;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.82);
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 30px;
}

.hero-rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.79rem;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.7);
}

.hero-rating strong {
    color: var(--white);
    font-weight: 500;
}

.hero-rating span[aria-hidden="true"] {
    margin-inline: 4px;
    color: rgba(255, 255, 255, 0.4);
}

/* Floating reservation card */
.hero-card {
    padding: 28px 27px 23px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-top: 3px solid var(--gold);
    border-radius: 5px;
    background: rgba(7, 21, 33, 0.55);
    backdrop-filter: blur(13px);
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.28);
}

.hero-card-label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.59rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-light);
}

.hero-card-title {
    margin-bottom: 18px;
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--white);
}

.hero-card-list {
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding-bottom: 17px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.hero-card-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.79rem;
    color: rgba(255, 255, 255, 0.82);
}

.hero-card-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border: 1px solid rgba(201, 162, 91, 0.6);
    border-radius: 50%;
}

.hero-card-icon svg {
    width: 10px;
    height: 10px;
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.hero-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 15px;
}

.hero-card-foot .hero-card-label {
    margin-bottom: 0;
}

.hero-card-foot a {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--white);
    transition: color 0.3s ease;
}

.hero-card-foot a:hover {
    color: var(--gold-light);
}

/* Quick-information strip, floating over the hero image */
.hero-strip {
    position: relative;
    z-index: 3;
    padding-bottom: 40px;
    margin-top: -24px;
}

.hero-strip-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid #ece5d7;
    border-radius: 8px;
    background: var(--white);
    box-shadow: 0 22px 48px rgba(4, 15, 25, 0.22);
}

.strip-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
}

.strip-item+.strip-item {
    border-left: 1px solid #f0ebe1;
}

.strip-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(201, 162, 91, 0.35);
    border-radius: 50%;
    background: #fcf9f2;
}

.strip-icon svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: var(--gold-deep);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.strip-label {
    display: block;
    margin-bottom: 1px;
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--gold-deep);
}

.strip-item div>span:last-child {
    display: block;
    font-size: 0.77rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--navy-900);
}

/* ================= 5. ABOUT ================= */
.about-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    align-items: center;
    gap: clamp(48px, 7vw, 92px);
}

.about-media {
    position: relative;
    padding-bottom: 26px;
}

.about-media::before {
    content: "";
    position: absolute;
    top: -16px;
    left: -16px;
    width: 58%;
    height: 58%;
    border-top: 1px solid var(--gold);
    border-left: 1px solid var(--gold);
    pointer-events: none;
}

.about-main {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: var(--shadow-large);
}

.about-accent {
    position: absolute;
    right: -18px;
    bottom: 0;
    width: 46%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 9px solid var(--white);
    border-radius: 5px;
    box-shadow: var(--shadow-soft);
}

.about-badge {
    position: absolute;
    bottom: 52px;
    left: -22px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: var(--navy-900);
    border-left: 3px solid var(--gold);
    border-radius: 3px;
    box-shadow: var(--shadow-large);
}

.about-badge-number {
    font-family: var(--serif);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--gold-light);
}

.about-badge-text {
    font-size: 0.59rem;
    line-height: 1.55;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
}

.about-content h2 {
    margin-bottom: 20px;
}

.about-intro {
    margin-bottom: 14px;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--navy-800);
}

.about-text {
    margin-bottom: 26px;
    font-size: 0.93rem;
    line-height: 1.85;
    color: var(--muted);
}

.about-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 22px;
    margin-bottom: 28px;
}

.about-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

.feature-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border-radius: 50%;
    background: rgba(201, 162, 91, 0.14);
    border: 1px solid rgba(201, 162, 91, 0.35);
}

.feature-icon svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: var(--gold-deep);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.about-features strong {
    display: block;
    font-size: 0.83rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--navy-900);
}

.about-features small {
    display: block;
    font-size: 0.74rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--muted);
}

.about-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
}

.about-signature {
    display: flex;
    align-items: center;
    gap: 12px;
}

.signature-avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--navy-900);
    border: 1px solid var(--gold);
    color: var(--gold-light);
    font-family: var(--serif);
    font-size: 0.92rem;
}

.about-signature strong {
    display: block;
    font-family: var(--serif);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy-900);
}

.about-signature small {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--muted);
}

/* ================= 6. ROOMS ================= */
.rooms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
}

.room-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--white);
    border: 1px solid #e8e1d4;
    border-radius: 14px;
    transition: transform 0.45s ease, box-shadow 0.45s ease, border-color 0.45s ease;
}

.room-card:hover {
    transform: translateY(-7px);
    border-color: rgba(201, 162, 91, 0.65);
    box-shadow: 0 28px 55px rgba(11, 31, 49, 0.13);
}

.room-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--ivory);
}

.room-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
}

.room-card:hover .room-media img {
    transform: scale(1.07);
}

.room-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 7px 12px;
    border: 1px solid rgba(227, 198, 138, 0.45);
    border-radius: 2px;
    background: rgba(7, 21, 33, 0.8);
    backdrop-filter: blur(6px);
    color: var(--gold-light);
    font-size: 0.57rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
}

.room-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px 27px 26px;
}

.room-type {
    margin-bottom: 5px;
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-deep);
}

.room-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding-bottom: 13px;
    border-bottom: 1px solid #f0ebe1;
}

.room-title-row h3 {
    font-size: 1.6rem;
    font-weight: 600;
}

.room-price {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--navy-900);
}

.room-price small {
    font-size: 0.66rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--muted);
}

.room-desc {
    margin: 13px 0;
    font-size: 0.87rem;
    line-height: 1.75;
    color: var(--muted);
}

.room-amenities {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
    margin-bottom: 16px;
}

.room-amenities li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.76rem;
    color: #53636e;
}

.room-amenities li::before {
    content: "";
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    border: 1px solid var(--gold);
    transform: rotate(45deg);
}

.room-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    padding-top: 15px;
    border-top: 1px solid #f0ebe1;
}

.room-note {
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--gold-deep);
}

.rooms-note {
    margin-top: 26px;
    font-size: 0.72rem;
    line-height: 1.7;
    text-align: center;
    color: var(--muted);
}

/* ================= 7. INTERLUDE QUOTE ================= */
.interlude {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 430px;
    padding: 100px 0;
    overflow: hidden;
    text-align: center;
    color: var(--white);
    background: var(--navy-950);
}

.interlude-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.interlude-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 16, 27, 0.86), rgba(5, 16, 27, 0.74));
}

.interlude-inner {
    position: relative;
    z-index: 2;
    max-width: 800px;
}

.interlude h2 {
    margin-bottom: 20px;
    font-size: clamp(2.2rem, 4.6vw, 3.7rem);
    color: var(--white);
}

.interlude h2 em {
    font-style: italic;
    font-weight: 400;
    color: var(--gold-light);
}

.interlude p:not(.eyebrow) {
    max-width: 610px;
    margin-inline: auto;
    font-size: 0.95rem;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.76);
}

/* ================= 8. FACILITIES ================= */
.facility-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.facility-card {
    position: relative;
    overflow: hidden;
    padding: 28px 24px 30px;
    background: var(--cream);
    border: 1px solid #ebe4d7;
    border-radius: 11px;
    transition: transform 0.4s ease, background-color 0.4s ease,
        border-color 0.4s ease, box-shadow 0.4s ease;
}

.facility-card::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
}

.facility-card:hover {
    transform: translateY(-6px);
    background: var(--navy-900);
    border-color: var(--navy-900);
    box-shadow: 0 22px 44px rgba(11, 31, 49, 0.18);
}

.facility-card:hover::after {
    transform: scaleX(1);
}

.facility-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 18px;
    border: 1px solid rgba(150, 112, 58, 0.35);
    border-radius: 50%;
    background: rgba(201, 162, 91, 0.08);
    transition: border-color 0.4s ease, background-color 0.4s ease;
}

.facility-icon svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: var(--gold-deep);
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.4s ease;
}

.facility-card:hover .facility-icon {
    border-color: rgba(227, 198, 138, 0.55);
    background: rgba(227, 198, 138, 0.1);
}

.facility-card:hover .facility-icon svg {
    stroke: var(--gold-light);
}

.facility-card h3 {
    margin-bottom: 8px;
    font-size: 1.28rem;
    font-weight: 600;
    transition: color 0.4s ease;
}

.facility-card p {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--muted);
    transition: color 0.4s ease;
}

.facility-card:hover h3 {
    color: var(--white);
}

.facility-card:hover p {
    color: rgba(255, 255, 255, 0.68);
}

/* ================= 9. BOOKING ================= */
.booking {
    position: relative;
    overflow: hidden;
    padding: 106px 0;
    background: var(--navy-950);
}

.booking::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 10% 15%, rgba(201, 162, 91, 0.16), transparent 42%),
        radial-gradient(circle at 90% 85%, rgba(201, 162, 91, 0.1), transparent 42%);
    pointer-events: none;
}

.booking-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    align-items: start;
    gap: clamp(40px, 6vw, 70px);
}

.booking-intro h2 {
    margin-bottom: 20px;
    color: var(--white);
}

.booking-text {
    max-width: 430px;
    font-size: 0.94rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.68);
}

.booking-points {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin-top: 27px;
}

.booking-points li {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.82);
}

.booking-point-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    border: 1px solid rgba(201, 162, 91, 0.55);
    border-radius: 50%;
}

.booking-point-icon svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.booking-call {
    display: flex;
    flex-direction: column;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
}

.booking-call-label {
    margin-bottom: 5px;
    font-size: 0.63rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
}

.booking-call a {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--gold-light);
    transition: color 0.3s ease;
}

.booking-call a:hover {
    color: var(--white);
}

.booking-call small {
    margin-top: 3px;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
}

.booking-form-card {
    padding: 34px 34px 28px;
    background: var(--white);
    border-top: 3px solid var(--gold);
    border-radius: 14px;
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.35);
}

.booking-form-card h3 {
    font-size: 2rem;
    font-weight: 600;
}

.form-sub {
    margin-top: 4px;
    font-size: 0.78rem;
    color: var(--muted);
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 18px;
    margin-top: 22px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.field--full {
    grid-column: 1 / -1;
}

.field label {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #334a5b;
}

.field label span {
    font-weight: 300;
    letter-spacing: 0.03em;
    text-transform: none;
    color: #9aa3aa;
}

.field input,
.field select,
.field textarea {
    width: 100%;
    min-height: 44px;
    padding: 11px 13px;
    background: #fcfbf8;
    border: 1px solid #ddd6c8;
    border-radius: 5px;
    color: var(--navy-900);
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 300;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
}

.field select {
    padding-right: 32px;
    cursor: pointer;
}

.field textarea {
    min-height: 96px;
    resize: vertical;
}

.field input::placeholder,
.field textarea::placeholder {
    color: #a3abb1;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
    outline: none;
    background: var(--white);
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201, 162, 91, 0.16);
}

.form-submit {
    width: 100%;
    margin-top: 22px;
}

.form-note {
    margin-top: 13px;
    padding: 10px 13px;
    background: #f7f4ec;
    border: 1px dashed #ded5c2;
    border-radius: 5px;
    font-size: 0.68rem;
    line-height: 1.65;
    color: #7c878f;
}

.form-note strong {
    color: var(--navy-800);
    font-weight: 500;
}

/* ================= 10. REVIEWS ================= */
.reviews-head {
    align-items: flex-end;
}

.rating-summary {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    padding-left: 24px;
    border-left: 1px solid #e3dccd;
}

.rating-score {
    font-family: var(--serif);
    font-size: 2.7rem;
    font-weight: 500;
    line-height: 1;
    color: var(--navy-900);
}

.rating-summary small {
    display: block;
    margin-top: 5px;
    font-size: 0.7rem;
    color: var(--muted);
}

.review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.review-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding: 30px 27px 25px;
    background: var(--white);
    border: 1px solid #e9e2d4;
    border-radius: 12px;
    transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
}

.review-card::before {
    content: "\201D";
    position: absolute;
    top: 8px;
    right: 22px;
    font-family: var(--serif);
    font-size: 5.4rem;
    line-height: 1;
    color: rgba(201, 162, 91, 0.22);
    pointer-events: none;
}

.review-card:hover {
    transform: translateY(-6px);
    border-color: rgba(201, 162, 91, 0.55);
    box-shadow: var(--shadow-soft);
}

.review-text {
    flex: 1;
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 400;
    font-style: italic;
    line-height: 1.65;
    color: #44535e;
}

.review-person {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid #f0ebe1;
}

.review-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #f3ecdd;
    border: 1px solid rgba(201, 162, 91, 0.45);
    color: var(--gold-deep);
    font-family: var(--serif);
    font-size: 0.9rem;
    font-weight: 600;
}

.review-person strong {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--navy-900);
}

.review-person small {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--muted);
}

/* Featured navy review card */
.review-card--featured {
    background: var(--navy-900);
    border-color: var(--navy-900);
    box-shadow: 0 18px 40px rgba(11, 31, 49, 0.2);
}

.review-card--featured::before {
    color: rgba(227, 198, 138, 0.3);
}

.review-card--featured .review-text {
    color: rgba(255, 255, 255, 0.84);
}

.review-card--featured .review-person {
    border-top-color: rgba(255, 255, 255, 0.16);
}

.review-card--featured .review-avatar {
    background: rgba(227, 198, 138, 0.14);
    border-color: rgba(227, 198, 138, 0.55);
    color: var(--gold-light);
}

.review-card--featured .review-person strong {
    color: var(--white);
}

.review-card--featured .review-person small {
    color: rgba(255, 255, 255, 0.55);
}

/* ================= 11. CONTACT ================= */
.contact-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(40px, 6vw, 78px);
}

.contact-content h2 {
    margin-bottom: 16px;
}

.contact-list {
    display: flex;
    flex-direction: column;
    margin-top: 26px;
}

.contact-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #eee8dd;
}

.contact-item:first-child {
    border-top: 1px solid #eee8dd;
}

.contact-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(201, 162, 91, 0.42);
    border-radius: 50%;
    background: rgba(201, 162, 91, 0.06);
}

.contact-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--gold-deep);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.contact-label {
    display: block;
    margin-bottom: 2px;
    font-size: 0.61rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-deep);
}

.contact-item p,
.hours-box p {
    font-size: 0.87rem;
    line-height: 1.65;
    color: var(--ink);
}

.contact-item a {
    transition: color 0.3s ease;
}

.contact-item a:hover {
    color: var(--gold-deep);
}

.hours-box {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 14px;
    padding: 15px 16px;
    background: var(--cream);
    border: 1px solid #eee8dd;
    border-left: 2px solid var(--gold);
    border-radius: 4px;
}

.hours-box p+p {
    margin-top: 4px;
}

.hours-box strong {
    font-weight: 500;
    color: var(--navy-900);
}

.contact-socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 22px;
}

.contact-socials>span {
    margin-right: 5px;
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
}

.contact-socials a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid #ddd5c6;
    border-radius: 50%;
    color: var(--navy-800);
    transition: background-color 0.3s ease, border-color 0.3s ease,
        color 0.3s ease, transform 0.3s ease;
}

.contact-socials a:hover {
    transform: translateY(-3px);
    background: var(--gold);
    border-color: var(--gold);
    color: var(--navy-950);
}

.contact-socials svg,
.footer-socials svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.contact-media {
    position: relative;
    padding-bottom: 30px;
}

.contact-media::before {
    content: "";
    position: absolute;
    top: -15px;
    right: -15px;
    width: 54%;
    height: 52%;
    border-top: 1px solid var(--gold);
    border-right: 1px solid var(--gold);
    pointer-events: none;
}

.contact-media>img {
    width: 100%;
    aspect-ratio: 10 / 11;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: var(--shadow-large);
}

.contact-card {
    position: absolute;
    right: 20px;
    bottom: 0;
    left: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 20px;
    background: var(--white);
    border-left: 3px solid var(--gold);
    border-radius: 3px;
    box-shadow: 0 16px 36px rgba(11, 31, 49, 0.16);
}

.contact-card .contact-label {
    margin-bottom: 2px;
}

.contact-card a {
    display: block;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--navy-900);
    transition: color 0.3s ease;
}

.contact-card a:hover {
    color: var(--gold-deep);
}

.contact-card small {
    display: block;
    font-size: 0.66rem;
    color: var(--muted);
}

.contact-card-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(201, 162, 91, 0.14);
}

.contact-card-icon svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: var(--gold-deep);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

/* ================= 12. FOOTER ================= */
.site-footer {
    padding-top: 68px;
    background: #050f1a;
    color: rgba(255, 255, 255, 0.62);
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 0.9fr 1.15fr;
    gap: 44px;
    padding-bottom: 46px;
}

.brand--footer .brand-mark {
    border-color: var(--gold);
    background: transparent;
    color: var(--gold-light);
}

.brand--footer .brand-mark::after {
    border-color: rgba(201, 162, 91, 0.28);
}

.brand--footer:hover .brand-mark {
    background: var(--gold);
    color: var(--navy-950);
}

.brand--footer .brand-title {
    color: var(--white);
}

.brand--footer .brand-subtitle {
    color: var(--gold-light);
}

.footer-brand>p {
    max-width: 280px;
    margin-top: 18px;
    font-size: 0.83rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.52);
}

.footer-socials {
    display: flex;
    gap: 8px;
    margin-top: 20px;
}

.footer-socials a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.7);
    transition: background-color 0.3s ease, border-color 0.3s ease,
        color 0.3s ease, transform 0.3s ease;
}

.footer-socials a:hover {
    transform: translateY(-3px);
    background: var(--gold);
    border-color: var(--gold);
    color: var(--navy-950);
}

.footer-col h4 {
    position: relative;
    margin-bottom: 19px;
    padding-bottom: 11px;
    color: var(--white);
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
}

.footer-col h4::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 22px;
    height: 1px;
    background: var(--gold);
}

.footer-links li {
    margin-bottom: 9px;
}

.footer-links a,
.footer-contact a {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.58);
    transition: color 0.3s ease, padding-left 0.3s ease;
}

.footer-links a {
    display: inline-block;
}

.footer-links a:hover {
    padding-left: 4px;
    color: var(--gold-light);
}

.footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 0.82rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.58);
}

.footer-contact svg {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    margin-top: 4px;
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.footer-contact a:hover {
    color: var(--gold-light);
}

.footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 22px;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.42);
}

.footer-disclaimer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
}

.footer-disclaimer a {
    color: var(--gold);
    transition: color 0.3s ease;
}

.footer-disclaimer a:hover {
    color: var(--gold-light);
}

/* ================= 13. RESPONSIVE DESIGN ================= */

/* Smaller desktops */
@media (max-width: 1120px) {
    .header-inner {
        gap: 20px;
    }

    .primary-nav ul {
        gap: 19px;
    }

    .hero-inner {
        grid-template-columns: 1.38fr 0.62fr;
        gap: 34px;
    }

    .hero-card {
        padding: 23px 21px 20px;
    }

    .hero-card-title {
        font-size: 1.4rem;
    }

    .section {
        padding: 90px 0;
    }

    .about-grid {
        gap: 48px;
    }

    .room-body {
        padding: 22px;
    }

    .facility-grid {
        gap: 18px;
    }

    .facility-card {
        padding: 25px 20px 27px;
    }

    .footer-grid {
        grid-template-columns: 1.4fr 0.8fr 0.8fr 1.1fr;
        gap: 32px;
    }
}

/* Tablets: wrapped navigation and stacked layouts */
@media (max-width: 960px) {
    html {
        scroll-padding-top: 140px;
    }

    section {
        scroll-margin-top: 140px;
    }

    .header-inner {
        flex-wrap: wrap;
        gap: 12px 18px;
    }

    .primary-nav {
        order: 3;
        flex-basis: 100%;
        width: 100%;
        margin-left: 0;
        padding-top: 11px;
        border-top: 1px solid #efe9dd;
    }

    .primary-nav ul {
        justify-content: center;
        gap: 8px 24px;
    }

    .header-cta {
        margin-left: auto;
    }

    .hero {
        min-height: 0;
    }

    .hero-inner {
        grid-template-columns: 1fr;
        gap: 30px;
        padding-top: 62px;
        padding-bottom: 52px;
    }

    .hero-content {
        max-width: 640px;
    }

    .hero-card {
        max-width: 520px;
    }

    .hero-strip-inner {
        grid-template-columns: 1fr 1fr;
        gap: 0;
        padding: 6px 8px;
    }

    .strip-item {
        padding: 12px 14px;
    }

    .strip-item:nth-child(odd) {
        border-left: 0;
    }

    .strip-item:nth-child(n + 3) {
        border-top: 1px solid #f0ebe1;
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 58px;
    }

    .about-media {
        max-width: 500px;
        margin-inline: auto;
        width: 100%;
    }

    .about-content {
        max-width: 680px;
    }

    .facility-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .booking-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .booking-text {
        max-width: 600px;
    }

    .booking-form-card {
        max-width: 720px;
        width: 100%;
    }

    .review-grid {
        grid-template-columns: 1fr 1fr;
    }

    .review-card:last-child {
        grid-column: 1 / -1;
    }

    .contact-grid {
        grid-template-columns: 1fr;
        gap: 52px;
    }

    .contact-content {
        max-width: 700px;
    }

    .contact-media {
        max-width: 560px;
        width: 100%;
        margin-inline: auto;
    }

    .footer-grid {
        grid-template-columns: 1.4fr 1fr 1fr;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-brand>p {
        max-width: 470px;
    }
}

/* Mobile */
@media (max-width: 720px) {
    .container {
        width: calc(100% - 36px);
    }

    .topbar-inner {
        justify-content: center;
    }

    .topbar-location,
    .topbar-item:first-child {
        display: none;
    }

    .topbar-right {
        justify-content: center;
        gap: 16px;
    }

    .topbar {
        font-size: 0.68rem;
    }

    .site-header {
        padding: 12px 0;
    }

    .brand-mark {
        width: 41px;
        height: 41px;
        font-size: 0.95rem;
    }

    .brand-title {
        font-size: 1.02rem;
        letter-spacing: 0.13em;
    }

    .brand-subtitle {
        font-size: 0.43rem;
        letter-spacing: 0.27em;
    }

    .header-cta {
        min-height: 40px;
        padding: 9px 14px;
        font-size: 0.61rem;
        letter-spacing: 0.1em;
    }

    .primary-nav ul {
        gap: 4px 16px;
    }

    .primary-nav a {
        font-size: 0.65rem;
        letter-spacing: 0.11em;
    }

    .section,
    .booking {
        padding: 72px 0;
    }

    .split-head {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 36px;
    }

    .head-note {
        max-width: 100%;
        padding-left: 16px;
    }

    .section-head {
        margin-bottom: 36px;
    }

    .hero-inner {
        padding-top: 48px;
        padding-bottom: 40px;
    }

    .hero h1 {
        font-size: clamp(2.6rem, 12vw, 3.7rem);
    }

    .hero-text {
        font-size: 0.93rem;
    }

    .hero-actions .btn {
        flex: 1 1 190px;
    }

    .hero-rating {
        font-size: 0.72rem;
        gap: 9px;
    }

    .hero-strip {
        margin-top: 0;
        padding-bottom: 28px;
    }

    .hero-strip-inner {
        grid-template-columns: 1fr;
        border-radius: 8px;
    }

    .strip-item,
    .strip-item:nth-child(odd) {
        padding: 11px 13px;
        border-left: 0;
        border-top: 1px solid #f0ebe1;
    }

    .strip-item:first-child {
        border-top: 0;
    }

    .about-media::before {
        top: -10px;
        left: -10px;
    }

    .about-accent {
        right: 0;
        width: 45%;
        border-width: 7px;
    }

    .about-badge {
        bottom: 35px;
        left: -6px;
        padding: 13px 15px;
    }

    .about-badge-number {
        font-size: 1.6rem;
    }

    .about-badge-text {
        font-size: 0.52rem;
    }

    .about-features {
        grid-template-columns: 1fr;
    }

    .about-intro {
        font-size: 1.2rem;
    }

    .rooms-grid {
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .room-body {
        padding: 20px;
    }

    .interlude {
        min-height: 380px;
        padding: 76px 0;
    }

    .interlude .eyebrow-rule:last-child {
        display: none;
    }

    .facility-grid {
        gap: 14px;
    }

    .facility-card {
        padding: 22px 18px 24px;
    }

    .facility-icon {
        width: 46px;
        height: 46px;
        margin-bottom: 14px;
    }

    .facility-card h3 {
        font-size: 1.12rem;
    }

    .facility-card p {
        font-size: 0.76rem;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .field--full {
        grid-column: auto;
    }

    .booking-form-card {
        padding: 26px 22px 22px;
    }

    .booking-form-card h3 {
        font-size: 1.7rem;
    }

    .review-grid {
        grid-template-columns: 1fr;
    }

    .review-card:last-child {
        grid-column: auto;
    }

    .rating-summary {
        padding-left: 0;
        padding-top: 14px;
        border-left: 0;
        border-top: 1px solid #e3dccd;
        width: 100%;
    }

    .rating-score {
        font-size: 2.2rem;
    }

    .contact-media>img {
        aspect-ratio: 4 / 4;
    }

    .contact-card {
        right: 12px;
        left: 12px;
        padding: 13px 16px;
    }

    .contact-card a {
        font-size: 1.1rem;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 32px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-col:last-child {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
        padding: 18px 0;
    }
}

/* Small phones */
@media (max-width: 480px) {
    html {
        scroll-padding-top: 152px;
    }

    section {
        scroll-margin-top: 152px;
    }

    .container {
        width: calc(100% - 28px);
    }

    .brand-mark {
        width: 37px;
        height: 37px;
        font-size: 0.85rem;
    }

    .brand-title {
        font-size: 0.9rem;
        letter-spacing: 0.1em;
    }

    .brand-subtitle {
        font-size: 0.39rem;
        letter-spacing: 0.22em;
    }

    .header-inner {
        gap: 10px 12px;
    }

    .header-cta {
        min-height: 37px;
        padding: 8px 12px;
        font-size: 0.56rem;
    }

    .header-cta svg {
        display: none;
    }

    .primary-nav ul {
        gap: 4px 13px;
    }

    .primary-nav a {
        font-size: 0.61rem;
        letter-spacing: 0.08em;
    }

    .hero h1 {
        font-size: clamp(2.35rem, 11.5vw, 3rem);
    }

    .hero-actions {
        gap: 10px;
    }

    .hero-actions .btn {
        flex-basis: 100%;
    }

    .hero-card {
        padding: 21px 18px 18px;
    }

    .hero-card-title {
        font-size: 1.3rem;
    }

    .stat-label {
        font-size: 0.47rem;
    }

    .eyebrow {
        font-size: 0.62rem;
        letter-spacing: 0.24em;
    }

    .about-badge {
        bottom: 28px;
    }

    .about-main {
        aspect-ratio: 4 / 4.6;
    }

    .about-foot .btn {
        width: 100%;
    }

    .room-title-row h3 {
        font-size: 1.42rem;
    }

    .room-amenities {
        grid-template-columns: 1fr;
    }

    .room-foot {
        flex-wrap: wrap;
    }

    .room-foot .btn {
        width: 100%;
    }

    .facility-grid {
        grid-template-columns: 1fr;
    }

    .booking-form-card {
        padding: 22px 17px 19px;
    }

    .booking-call a {
        font-size: 1.35rem;
    }

    .contact-card-icon {
        display: none;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }

    .footer-brand,
    .footer-col:last-child {
        grid-column: auto;
    }
}

/* Respect users who prefer reduced motion */
@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
